{
  "name": "prompthub_backend",
  "version": "1.0.0",
  "description": "backend for PromptHub",
  "license": "ISC",
  "author": "skyzary",
  "type": "module",
  "main": " ",
  "scripts": {
    "start": "tsc src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "migrate:prompt-icon": "node -r dotenv/config --import tsx/esm src/migrations/add-prompt-icon.ts",
    "migrate:user-rating": "node -r dotenv/config --import tsx/esm src/migrations/add-user-rating.ts",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
