# syntax=docker/dockerfile:1

# ---- Base Image with pnpm ----
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10 --activate

# ---- Dependencies (dev + prod для сборки TypeScript) ----
FROM base AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# ---- Local / Test Runtime (hot-reload через tsx или сборка dist) ----
FROM base AS local-runtime
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Переменные по умолчанию для локального тестирования
ENV NODE_ENV=development
ARG PORT=4300
ENV PORT=${PORT}

EXPOSE ${PORT}

# Запуск бэкенда через tsx напрямую (без необходимости компиляции dist)
CMD ["npx", "tsx", "src/index.ts"]

