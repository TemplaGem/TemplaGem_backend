          "button[type=\"submit\"]"
        ]
      },
      "editor": {
        "type": "prosemirror",
        "insertStrategy": "inputEvent"
      },
      "popover": {
        "attachTo": "container",
        "offset": { "x": 0, "y": 12 }
      }
    },
    {
