PORT=4300

# Режим подключения: "local" или "remote"
# Если в контейнере/окружении уже передан MONGO_URL, он имеет приоритет
MONGO_ENV=local

# Локальная база данных (localhost / 127.0.0.1)
MONGO_LOCAL_URL=mongodb://promptHub:promptHub@127.0.0.1:27017/promptHub?authSource=admin

# Удаленная база данных (production / remote host / cloud Atlas)
MONGO_REMOTE_URL=mongodb://promptHub:promptHub@176.138.97.78:27017/promptHub?authSource=admin

ACCESS_SECRET=your_access_secret_here
REFRESH_SECRET=your_refresh_secret_here
ACCESS_EXPIRES=15m
REFRESH_EXPIRES=7d

