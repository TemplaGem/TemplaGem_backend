{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "TemplaGem API",
    "description": "Коллекция эндпоинтов TemplaGem backend.\n\n1. Register / Login — accessToken сохранится в переменную коллекции автоматически.\n2. Для Prompts нужен Bearer token (берётся из {{accessToken}}).\n\nAuth-роуты ожидаются на `/api/auth` (подключи `authRouter` в `index.ts`, если ещё не подключён).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "port",
      "value": "4300"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:{{port}}"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "user@example.com"
    },
    {
      "key": "password",
      "value": "Password1!"
    },
    {
      "key": "promptId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Регистрация пользователя.\nПароль: 8–32 символа, минимум одна заглавная буква и один спецсимвол."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Логин. Сохраняет accessToken в переменную коллекции. Refresh token приходит в httpOnly cookie."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Обновление accessToken по refreshToken из cookie. После Login cookie подхватится автоматически."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Очищает refreshToken cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Update Email",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newEmail\": \"newuser@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "email"]
            },
            "description": "Обновление email текущего пользователя (определяется по Bearer-токену)."
          },
          "response": []
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "password"]
            },
            "description": "Обновление пароля текущего пользователя. Те же правила валидации, что и при регистрации."
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Удаление текущего пользователя (определяется по Bearer-токену)."
          },
          "response": []
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Prompts",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get Prompts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prompts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts"]
            },
            "description": "Получение всех промптов текущего пользователя. Требует Authorization: Bearer {{accessToken}}."
          },
          "response": []
        },
        {
          "name": "Create Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"title\": \"My first prompt\",\n  \"body\": \"You are a helpful assistant.\",\n  \"tags\": [\"assistant\", \"general\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts", "create"]
            },
            "description": "Создание промпта. Требует Authorization: Bearer {{accessToken}}."
          },
          "response": []
        },
        {
          "name": "Update Prompt Title",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"promptId\": \"{{promptId}}\",\n  \"title\": \"Updated title\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts/change/title",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts", "change", "title"]
            },
            "description": "Обновление заголовка промпта."
          },
          "response": []
        },
        {
          "name": "Update Prompt Body",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"promptId\": \"{{promptId}}\",\n  \"body\": \"Updated prompt body text.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts/change/body",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts", "change", "body"]
            },
            "description": "Обновление тела промпта."
          },
          "response": []
        },
        {
          "name": "Update Prompt Tags",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"promptId\": \"{{promptId}}\",\n  \"tags\": [\"coding\", \"review\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts/change/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts", "change", "tags"]
            },
            "description": "Обновление тегов промпта."
          },
          "response": []
        },
        {
          "name": "Update Prompt Icon",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promptId\": \"{{promptId}}\",\n  \"icon\": \"sparkles\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts/change/icon",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts", "change", "icon"]
            },
            "description": "Обновление иконки промпта."
          },
          "response": []
        },
        {
          "name": "Delete Prompt",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"promptId\": \"{{promptId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts/delete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prompts", "delete"]
            },
            "description": "Удаление промпта. Body обязателен."
          },
          "response": []
        }
      ]
    }
  ]
}
